#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/studio.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // Home row mods configuration
        // Tap = regular key, Hold = modifier

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // | CTRL | A/CG| S/A | D/G | F/SF|  G  |   |  H  | J/SF| K/G | L/A | ;/CG|  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ESC  |
            //                    | GUI | TOG1| SPC |   | ENT | TOG2| MOUSE|

            bindings = <
&kp TAB    &kp Q           &kp W       &kp E               &kp R        &kp T      &kp Y      &kp U        &kp I                &kp O       &kp P               &kp BSPC
&kp CAPS   &hm LEFT_GUI A  &hm LALT S  &hm LEFT_CONTROL D  &hm LSHFT F  &kp G      &kp H      &hm RSHFT J  &hm RIGHT_CONTROL K  &hm RALT L  &hm RIGHT_GUI SEMI  &kp SQT
&kp LSHFT  &kp Z           &kp X       &kp C               &kp V        &kp B      &kp N      &kp M        &kp COMMA            &kp DOT     &kp FSLH            &kp ESC
                                       &tog 3              &mo 1        &kp RET    &kp SPACE  &mo 2        &tog 3
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | DEL  |
            // |      | LFT | DWN |  UP | RGT |     |   | HOME| PGDN| PGUP| END |     |      |
            // |      |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI | TOG0| SPC |   | ENT | ADJ | ALT |

            bindings = <
&kp ESC  &trans    &kp PG_UP       &kp UP    &kp PG_DN  &trans     &kp PAGE_DOWN   &kp N7  &kp N8    &kp N9  &kp PAGE_UP  &kp DEL
&trans   &kp HOME  &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &kp END    &kp LEFT_SHIFT  &kp N4  &kp N5    &kp N6  &kp END      &trans
&trans   &trans    &trans          &trans    &trans     &trans     &kp N0          &kp N1  &kp N2    &kp N3  &trans       &trans
                                   &tog 0    &tog 0     &trans     &trans          &trans  &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | DEL  |
            // |      |  -  |  =  |  [  |  ]  |  \  |   |     |     |     |     |     |      |
            // |      |  _  |  +  |  {  |  }  | "|" |   |     |     |     |     |     |      |
            //                    | GUI | ADJ | SPC |   | ENT | TOG0| ALT |

            bindings = <
&kp ESC  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET   &kp AMPS      &kp ASTRK     &kp LPAR      &kp RPAR  &kp DEL
&trans   &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH     &trans      &trans        &trans        &trans        &trans    &trans
&trans   &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE     &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans    &studio_unlock
                               &tog 0    &tog 0    &kp RET      &kp SPACE   &tog 0        &kp RALT
            >;
        };

        mouse_layer {
            // -----------------------------------------------------------------------------------------
            // |      |     | MS_U|     |     |     |   |     |     |     |     |     |      |
            // |      | MS_L| MS_D| MS_R|     |     |   |     | LFT | DWN | RGT |     |      |
            // |      |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    |     |     |     |   | MK1 | MK2 | MK3 |

            bindings = <
&trans  &trans  &kp PAGE_UP  &kp UP    &kp PAGE_DOWN  &kp PG_UP         &msc SCRL_UP     &msc SCRL_DOWN  &mmv MOVE_UP    &trans           &trans  &trans
&trans  &trans  &kp LEFT     &kp DOWN  &kp RIGHT      &kp LEFT_SHIFT    &kp RIGHT_SHIFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans       &trans    &trans         &trans            &trans           &trans          &trans          &trans           &trans  &trans
                             &tog 0    &tog 0         &trans            &mkp LCLK        &mkp RCLK       &mkp MCLK
            >;
        };
    };
};
